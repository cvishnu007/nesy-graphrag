# Source selection: "arxiv" or "s2"
DATA_SOURCE=s2

# Neo4j
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_me
# Required by the graph-build command because it clears its dedicated database.
NEO4J_ALLOW_RESET=true

# LLM provider
GROQ_API_KEY=replace_me

# Semantic Scholar (rotate any previously exposed key before using)
SEMANTIC_SCHOLAR_API_KEY=replace_me
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_MIN_INTERVAL_SEC=1.05
SEMANTIC_SCHOLAR_TIMEOUT_SEC=45
SEMANTIC_SCHOLAR_MAX_RETRIES=6
S2_QUERY=graph neural networks
# Semicolon-separated broad CSE collection. S2_QUERY remains the single-query fallback.
S2_QUERIES=graph neural networks;artificial intelligence and machine learning;cybersecurity;computer networks;databases;software engineering;cloud computing;natural language processing;computer vision;data science;operating systems
S2_LIMIT=10000
S2_LIMIT_PER_QUERY=5000
S2_INCLUDE_EXISTING=true
S2_CHECKPOINT_FILE=./data/s2_ingestion_checkpoint.json
S2_PAGE_SIZE=1000
S2_YEAR=2020-2025
S2_FIELDS_OF_STUDY=Computer Science
S2_PUBLICATION_TYPES=
S2_SORT=citationCount:desc
S2_BATCH_SIZE=500
S2_MAX_REFS_PER_PAPER=200

# Storage paths (leave defaults unless needed)
CHROMA_DIR=./data/chromadb
ARXIV_RAW_FILE=./data/arxiv_raw.json
ARXIV_CLEAN_FILE=./data/arxiv_clean.json
ARXIV_NER_FILE=./data/arxiv_ner.json
S2_RAW_FILE=./data/s2_raw.json
S2_CLEAN_FILE=./data/s2_clean.json
S2_NER_FILE=./data/s2_ner.json

# Optional overrides that follow DATA_SOURCE by default
# RAW_FILE=
# CLEAN_FILE=
# NER_FILE=

CHROMA_COLLECTION=s2_papers
USE_REAL_CITATIONS=true

# Models
EMBEDDING_MODEL=allenai-specter
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_FALLBACK=llama-3.1-8b-instant
GROQ_MAX_RETRIES=4

# Pipeline tuning
BATCH_SIZE=64
NEO4J_BATCH_SIZE=500
TOP_K=10
HOP_DEPTH=2
RRF_K=60
NEURAL_FUSION_WEIGHT=1.0
GRAPH_FUSION_WEIGHT=1.0
# Production graph-candidate relevance filter. The defaults were tuned on the
# retrieval benchmark development split; change them only after re-evaluation.
GRAPH_HIGH_SEMANTIC_THRESHOLD=0.85
GRAPH_SEMANTIC_FLOOR=0.75
GRAPH_MIN_QUERY_TERM_COVERAGE=0.75
GRAPH_STRONG_CONNECTIONS=10
CITES_THRESHOLD=2
MAX_AUTHORS=5
MAX_CONCEPTS=10
MIN_ABSTRACT_WORDS=30
EVALUATION_START_YEAR=2020
EVALUATION_END_YEAR=2025

# Optional resource overrides. Leave commented to auto-detect the machine.
# TORCH_NUM_THREADS=15
# TORCH_INTEROP_THREADS=4
SPACY_DEVICE=auto
SPACY_GPU_ID=0
# SPACY_N_PROCESS=15
SPACY_BATCH_SIZE=128

# Contradiction candidate quality
CONTRADICTION_MIN_SHARED_CONCEPTS=2
CONTRADICTION_MIN_CONCEPT_JACCARD=0.10
CONTRADICTION_CANDIDATE_POOL=25
CONTRADICTION_MIN_CONFIDENCE=0.70

# Hypothesis candidate quality
HYPOTHESIS_MIN_SHARED_CONCEPTS=2
HYPOTHESIS_MIN_QUERY_SUPPORT=2
HYPOTHESIS_CANDIDATE_POOL=25
